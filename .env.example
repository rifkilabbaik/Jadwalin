# Salin file ini menjadi .env lalu isi. Semua isian OPSIONAL.
# Tanpa token, Pesanin tetap jalan dengan input manual dan folder inbox/.

# Token akses Instagram Graph API (lewat Facebook Login / akun bisnis Meta).
# Gunakan long-lived user token (berlaku 60 hari) atau token System User.
IG_ACCESS_TOKEN=

# ID akun Instagram Bisnis/Kreator milik Anda (angka, bukan username).
IG_USER_ID=

# Versi Graph API yang dipakai. Ganti jika Meta sudah menghentikan versi ini.
GRAPH_API_VERSION=v23.0
